    "pre_install": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Write-Host (\"`nPersisting $env:APPDATA\\lx-music-desktop ... \") -NoNewline",
        "New-PersistDirectory \"$env:APPDATA\\lx-music-desktop\" \"$persist_dir\\AppData\" -Migrate"
