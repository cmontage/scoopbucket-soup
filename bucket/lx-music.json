    "pre_install": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Write-Host (\"`nPersisting $env:APPDATA\\lx-music-desktop ... \") -NoNewline",
        "New-PersistDirectory \"$env:APPDATA\\lx-music-desktop\" \"$persist_dir\\AppData\" -Migrate"
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App"
    ],
    "post_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Write-Host (\"`nDeleting $env:APPDATA\\lx-music-desktop ... \") -f DarkGray -NoNewline",
        "Remove-Junction \"$env:APPDATA\\lx-music-desktop\"  -Force -Recurse -ErrorAction SilentlyContinue | Out-Null"
    ],
    "bin": "lx-music-desktop.exe",
    "shortcuts": [
        [
            "lx-music-desktop.exe",
            "洛雪音乐助手"
